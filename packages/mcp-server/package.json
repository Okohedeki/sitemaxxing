{
  "name": "@sitemaxxing/mcp-server",
  "version": "0.1.0",
  "description": "Sitemaxxing hub: MCP server (Streamable HTTP) plus the WebSocket hub shared by the overlay and the control room.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
