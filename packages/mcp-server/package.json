    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sitemaxxing/core": "workspace:*",
    "@sitemaxxing/mog-score": "workspace:*",
    "@sitemaxxing/overlay": "workspace:*",
    "@sitemaxxing/passes": "workspace:*",
    "@sitemaxxing/rules": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
