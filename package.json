{
  "name": "sitemaxxing-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Give any website a glow-up: live, reviewable design passes committed as versions.",
  "license": "MIT",
  "packageManager": "pnpm@8.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./apps/control-room\" run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
